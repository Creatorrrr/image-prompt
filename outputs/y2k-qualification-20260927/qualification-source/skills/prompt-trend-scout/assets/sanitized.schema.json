  "properties": {
    "id": {"type": "string"},
    "from_harvest_id": {"type": "string"},
    "sanitized_prompt": {"type": "string"},
    "stripped_segments": {"type": "array"},
    "image_observation": {"type": "object"},
    "abstract_visual_grammar": {"type": "object"},
    "no_raw_reuse": {"type": "boolean"},
    "flags": {"type": "array", "items": {"type": "string"}}
  }
}
