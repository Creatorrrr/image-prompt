"""Adopt reviewed optional folk-horror propositions, preserving existing sources."""
from pathlib import Path
import copy,hashlib,json,sys,uuid
O=Path(__file__).resolve().parent;R=O.parents[2];S=R/'skills/photo-prompt-image-generator';A=S/'assets'
Q=R/'docs/research-evidence/photo-prompt/folk-horror-20261022'
sys.path.insert(0,str(S/'scripts'))
import photo_candidate_corpus as c
from photo_runtime_sources import source_update
read=lambda p:json.loads(p.read_bytes())
def write(p,x):p.write_text(json.dumps(x,ensure_ascii=False,indent=2)+'\n')
sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()

# Directly reviewed whole-proposition mutation footprints, not inferred from
# the research graph. No typed fact, owner permission or native approval added.
FOOTPRINTS='''
L01:setting material appearance composition
L02:subject count pose setting composition relationship
L03:setting material lighting appearance composition count
L04:setting material appearance composition relationship count
L05:subject age pose count setting material appearance relationship
L06:setting material appearance composition count
