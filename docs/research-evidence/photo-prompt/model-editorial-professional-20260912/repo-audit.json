          ],
          "requires_adult_character": false
        },
        "semantics": {
          "definition": "A balanced full-body standing pose in which most weight rests on one support leg, the other leg relaxes or bends, and the pelvis and shoulders counter-tilt around a stable head and torso balance.",
          "paraphrase_examples": [
            "한쪽 지지 다리에 체중을 싣고 반대 다리를 풀며 골반과 어깨가 대응해 기울어진 전신 자세",
            "a support leg and relaxed free leg producing opposed pelvic and shoulder tilts",
            "balanced classical weight shift readable from head to feet"
          ],
          "component_semantics": {
            "minimum_component_groups": 4,
            "required_group_ids": [
              "support_leg",
              "free_leg",
              "counter_tilt",
              "full_body_balance"
            ],
            "groups": [
              {
                "id": "support_leg",
                "any_terms": [
                  "most weight on one straight support leg",
                  "loaded standing leg",
                  "체중을 받는 한쪽 지지 다리"
                ]
              },
              {
                "id": "free_leg",
                "any_terms": [
                  "opposite leg relaxed or bent",
                  "unloaded free leg",
                  "힘을 뺀 반대쪽 다리"
                ]
              },
              {
                "id": "counter_tilt",
                "any_terms": [
                  "pelvis and shoulders tilt in opposed balance",
                  "counter-tilted hip and shoulder lines",
                  "골반과 어깨의 대응 경사"
                ]
              },
              {
                "id": "full_body_balance",
                "any_terms": [
                  "head-to-feet full-body balance",
                  "stable head over the weight shift",
                  "머리부터 발끝까지 보이는 균형"
                ]
              }
            ]
          },
          "contrast_examples": [
            "a generic relaxed standing pose with no readable support leg",
            "both knees equally bent in a symmetrical fashion pose",
            "an S-shaped crop that hides the feet and load path"
          ]
        }
      }
    },
    {
      "file": "skills/photo-prompt-image-generator/assets/photo_prompt_visual_obligations.json",
      "json_pointer": "/profiles/258",
      "id": "contact_sheet_selection_context",
      "record_sha256": "f1f452d44d0bf8efc9e298e449a6128053cff153139b89387b3ed26440d93b8a",
      "record_excerpt": {
        "activation": {
          "exact_terms": [
            "contact-sheet selection photograph",
            "photographic contact sheet with selection mark",
            "sequential proof-sheet photograph",
            "선택 표시가 있는 컨택트 시트",
            "연속 프레임 사진 컨택트 시트",
            "사진 셀렉용 밀착 인화지"
          ],
          "project_glossary_aliases": [
            "셀렉 표시 컨택트 시트"
          ],
          "requires_adult_character": true,
          "semantic_discovery_requires_component_evidence": true
        },
        "semantics": {
          "definition": "A proof sheet shows multiple temporally adjacent frames of the same clearly adult subject and scene, arranged in a consistent contact-grid or film-strip system with one visible selection mark or chosen frame. The sheet makes an editing sequence observable, while B-cut, outtake, publication, and rejection status remain metadata unless the selection context is shown.",
          "paraphrase_examples": [
            "같은 성인 피사체의 연속 동작이 작은 프레임들로 이어지고 한 컷에 셀렉 표시가 된 밀착 인화지",
            "B컷이나 아웃테이크라는 말 대신 실제 촬영 시퀀스와 선택 과정을 화면에 보이는 형태로 만든 사진",
            "a consistent proof sheet of near-adjacent adult portrait frames with one circled selection"
          ],
          "component_semantics": {
            "minimum_component_groups": 5,
            "required_group_ids": [
              "repeated_same_subject_scene",
              "temporal_micro_progression",
              "contact_grid_or_film_strip",
              "single_selection_mark",
              "consistent_frame_system"
            ],
            "groups": [
              {
                "id": "repeated_same_subject_scene",
                "any_terms": [
                  "the same clearly adult subject and scene repeat across multiple small frames",
                  "같은 분명한 성인 피사체와 장면이 여러 작은 프레임에 반복됨"
                ]
              },
              {
                "id": "temporal_micro_progression",
                "any_terms": [
                  "pose gaze or action changes by small adjacent steps from frame to frame",
                  "포즈 시선 또는 행동이 프레임마다 작은 연속 단계로 변함"
                ]
              },
              {
                "id": "contact_grid_or_film_strip",
                "any_terms": [
                  "a regular proof-sheet grid or film-strip structure contains the sequence",
                  "규칙적인 밀착 인화 격자 또는 필름 스트립 구조가 시퀀스를 담음"
                ]
              },
              {
                "id": "single_selection_mark",
                "any_terms": [
                  "one frame carries a visible circle grease-pencil mark or equivalent selection cue",
                  "한 프레임에 원형 표시 그리스펜 또는 동등한 셀렉 단서가 보임"
                ]
              },
              {
                "id": "consistent_frame_system",
                "any_terms": [
                  "uniform frame dimensions spacing and scene continuity distinguish the sheet from a decorative collage",
                  "균일한 프레임 크기 간격과 장면 연속성이 장식 콜라주와 구별됨"
                ]
              }
            ]
          },
          "contrast_examples": [
            "a decorative scrapbook collage",
            "unrelated portraits arranged in a mood board",
            "one photograph with a film border",
            "a repeated identical tile with no temporal change",
            "a single image merely labeled B-cut or outtake"
          ]
        }
      }
