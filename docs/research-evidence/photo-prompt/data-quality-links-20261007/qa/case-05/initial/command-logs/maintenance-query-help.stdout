usage: cli.py query [-h] (--report REPORT | --report-store REPORT_STORE)
                    (--candidate CANDIDATE | --profile PROFILE |
                    --bundle BUNDLE) [--require-current]
                    [--source-root SOURCE_ROOT]
                    [--runtime-store RUNTIME_STORE]

options:
  -h, --help            show this help message and exit
  --report REPORT
  --report-store REPORT_STORE
  --candidate CANDIDATE
  --profile PROFILE
  --bundle BUNDLE
  --require-current
  --source-root SOURCE_ROOT
  --runtime-store RUNTIME_STORE
