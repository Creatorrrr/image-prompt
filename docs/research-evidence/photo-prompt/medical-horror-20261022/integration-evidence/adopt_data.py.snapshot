 current=c.load(A);config=read(S/'retrieval-runtime.json');store=Path.home()/'.cache/image-prompt/photo-shared-runtime/h-f2-installed'
 protected=[S/'SKILL.md',S/'retrieval-runtime.json',A/'photo_candidate_search.json']+[A/m['file'] for m in read(A/c.MANIFEST_NAME)['modules']]
 protected += list((S/'precore').glob('*.*'))+list((S/'scripts').glob('*.py'))
 before=dict(head=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(),config=config,store=str(store),native=str(store/'generations'/config['native_generation_id']),runtime_python=str(S/'.runtime/embedding-python/bin/python'),corpus_sha256=c.digest(current),candidate_count=len(current['candidates']),binding_count=len(current['slot_bindings']),protected_hashes={str(p.relative_to(R)):sha(p) for p in protected if p.is_file()},git_status=subprocess.check_output(['git','status','--short'],text=True))
 write(O/'before.json',before)
 cards=read(Q/'semantic-cards.json');sources={s['id']:s for s in read(Q/'sources.json')};records={};bindings={};registry=[];decisions=[]
 reuse={'D16':'cand_6ae44ec9028b5eb39009f3e3bd91a8ba','L01':'cand_3a07312de26c59f2890147fc6dab3ad1'}
 app='One complete optional authored visual realization. Preserve every English and Korean positive clause, owner, count, part, endpoint, relation, visible state and explicit fictional, illustrative or staged mode. Adopt only if the independently frozen requester meaning and all affected dimensions and properties permit the complete source. All distinguishing components and endpoints must be legible together in the actual selected image; hidden, cropped, ambiguous or partial required evidence does not pass. A proxy depicts only its stated visible structure, not a diagnosis, consciousness, pain, consent, function, genetic origin, life state, history, sound or causation. Research relation graphs, aliases and citations create no typed native facts, guard support, owner permissions or whole-source native qualification.'
 for card in cards:
  key=card['id'];visual=not key.startswith('X') and key!='W04'
  if key in reuse:
   cid=reuse[key];assert cid in current['candidates'];original=current['candidates'][cid]
   meta={**copy.deepcopy(card),'candidate_id':cid,'registration_status':'existing_complete_source_reused','positive_en':original['content']['en'],'positive_ko':original['content']['ko'],'reused_proposal_delta':'Research-only narrower details are not added to the existing source or claimed as adopted.','native_approval':False}
   registry.append(meta);decisions.append(dict(card_id=key,candidate_id=cid,decision='reuse',reason='Existing complete source covers the generic seam or vessel-scale relation; narrower closed-seam/millimeter details remain authorial or require separate future review.'));continue
  cid='cand_'+uuid.uuid5(uuid.NAMESPACE_URL,'image-prompt/medical-horror/20261022/'+key).hex
  assert cid not in current['candidates']
  if visual:en=card['phrase_en'];ko=card['phrase_ko'];dims=sorted(EFF[key])
  elif key=='W04':en='Prolapse retains its body-region-specific clinical definition. This research proposal needs further anatomical source review and is not a positive visual prescription or a synonym for wound evisceration.';ko='탈출·하수는 신체 부위별 임상 정의를 유지한다. 해당 연구 모형은 해부학적 출처 추가 검토가 필요하여 긍정 시각 처방으로 등록하지 않으며 창상 내장탈출과 동일시하지 않는다.';dims=[]
  else:en=CONTEXT_EN[int(key[1:])-1];ko=card['claim_limit_ko'];dims=[]
  meta={**copy.deepcopy(card),'schema':'photo-medical-horror-visual-semantics/v1','candidate_id':cid,'runtime_registration':True,'registration_status':'authored_visual_source' if visual else 'diagnostic_context_only','native_approval':False,'native_qualification':'not_qualified','activation':'optional_post_core; genre labels never activate all source obligations','source_refs':[sources[s] for s in card['source_refs']],'graph_scope':'research metadata only; not native facts or guard evidence','provenance_digest_scope':'research specification bytes, not downloaded source page bytes'}
  aliases=list(dict.fromkeys(card['seed_terms']+[card['title_ko']]))
  if visual:
   aliases+=list(dict.fromkeys(r['ko'] for r in read(Q/'keyword-routes.json') if r['en'] in card['seed_terms']))
   aliases=list(dict.fromkeys(aliases))
  rec=dict(id=cid,record_kind='visual_option' if visual else 'diagnostic',content=dict(en=en,ko=ko,definition=('Optional medical-horror visual realization: '+card['title_ko']) if visual else 'Context-only medical-horror distinction; excluded from positive material retrieval.',aliases=aliases,application_contract=app if visual else 'Diagnostic/context-only boundary; do not promote an invisible claim or a deferred clinical form into positive image facts.',research_semantics=meta),conditions={'requires_adult_context':True} if visual and re_adult(en) else {},effects=dict(dimensions=dims,properties=[]),provenance=[dict(source=sources[s]['url'],sha256=sha(Q/'semantic-cards.json')) for s in card['source_refs']])
  records[cid]=rec;registry.append(meta)
  if visual:
   for slot in card['proposed_slots']:
    catalog=current['slot_catalog'][slot];bid='bind_'+uuid.uuid5(uuid.NAMESPACE_URL,cid+'/'+slot).hex
    bindings[bid]=dict(id=bid,candidate_id=cid,slot_id=slot,role='optional',semantic_role=catalog['semantic_role'],conditions={'subject_applicability':{}},weight=2)
  decisions.append(dict(card_id=key,candidate_id=cid,decision='new' if visual else 'defer' if key=='W04' else 'context',reason='Bounded complete bilingual optional variant; lexical zero is not proof of exhaustive novelty.' if visual else 'Invisible/deferred claim retained outside positive appearance retrieval.'))
 proposed=copy.deepcopy(current);proposed['candidates'].update(records);proposed['slot_bindings'].update(bindings);c.validate(proposed)
 nm='photo_candidate_medical_horror_20261022.json';bm='photo_candidate_medical_horror_bindings_20261022.json';manifest=read(A/c.MANIFEST_NAME)
 assert not any(x['file'] in [nm,bm] for x in manifest['modules'])
 manifest['modules'] += [dict(file=nm,kind='candidates'),dict(file=bm,kind='slot_bindings')]
 with source_update(S):
  assert c.digest(c.load(A))==before['corpus_sha256'],'Concurrent source change before adoption'
  write(A/nm,dict(schema=c.MODULE_SCHEMAS['candidates'],candidates=records));write(A/bm,dict(schema=c.MODULE_SCHEMAS['slot_bindings'],slot_bindings=bindings));write(A/c.MANIFEST_NAME,manifest)
  now=c.load(A)
  assert all(now['candidates'][k]==v for k,v in current['candidates'].items())
  assert all(now['slot_bindings'][k]==v for k,v in current['slot_bindings'].items())
  assert all(now[k]==current[k] for k in ('slot_catalog','policies'))
 lookup={x['id']:x['candidate_id'] for x in registry}
 routes=[{**r,'candidate_ids':[lookup[i] for i in r['visual_card_ids']+r['boundary_card_ids']],'activation':'contextual discovery only, not native permission or automatic hard profile'} for r in read(Q/'keyword-routes.json')]
 counts=dict(cards=len(cards),visual_sources_new=sum(r['record_kind']=='visual_option' for r in records.values()),reused=2,diagnostics_new=sum(r['record_kind']=='diagnostic' for r in records.values()),bindings_new=len(bindings),keyword_routes=len(routes),before_candidates=len(current['candidates']),after_candidates=len(now['candidates']))
 result=dict(schema='photo-medical-horror-semantic-registry/v1',cards=registry,keyword_routes=routes,decisions=decisions,counts=counts,native_approval=False,research_spec_sha256=sha(Q/'semantic-cards.json'))
 write(A/'photo_medical_horror_semantics_20261022.json',result);write(O/'data-integration.json',result);write(O/'new-native-records.json',records);write(O/'changed-native-records.json',{})
 write(O/'source-preservation.json',dict(status='pass',old_candidates_preserved=len(current['candidates']),old_bindings_preserved=len(current['slot_bindings']),catalog_and_policies_unchanged=True,before_corpus_sha256=before['corpus_sha256'],after_corpus_sha256=c.digest(now),counts=counts))
 print(json.dumps(counts))

def re_adult(text):
 import re
 return bool(re.search(r'\badult(?:s|’s|\x27s)?\b',text,re.I))
