        "support_and_balance": {
          "status": "supported",
          "reason": "The flat right foot bears the center of mass. Left ball and toes remain grounded as that ankle plantarflexes to raise the heel; neither hands nor bench are load-bearing for the body.",
          "prompt_evidence": [
            "Her weight rests over the flat right foot",
            "the left ball and toes remain planted"
          ]
        },
        "contact_and_space": {
          "status": "supported",
          "reason": "Upturned palm heels lightly contact chin underside while finger fans remain beneath cheeks. Standing in front of the offset bench leaves hand space and a readable floor gap beneath the left heel.",
