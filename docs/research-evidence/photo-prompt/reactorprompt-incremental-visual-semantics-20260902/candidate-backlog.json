    {
      "id": "VS-P0-001",
      "priority": "P0",
      "title": "Typed relation provenance and single ownership",
      "status": "proposed",
      "target_layers": ["module", "reference", "policy", "test"],
      "proposal": "Define photo-visual-relation/v1 metadata shared by topic-specific IRs: source kind, literal evidence, priority, one owner axis, entities or visible regions, relations, observable effects, confusion negatives, invariant fields, and flexible fields.",
      "acceptance_before_implementation": [
        "Every active relation has exactly one canonical owner.",
        "Request-locked fields cannot be overwritten by post-core candidates.",
        "Advisory retrieval cannot create hard gates before explicit selection."
      ]
    },
    {
      "id": "VS-P0-002",
      "priority": "P0",
      "title": "Observability and proof budget",
      "status": "proposed",
      "target_layers": ["module", "policy", "test"],
      "proposal": "Attach required_visible_regions, minimum_review_scale, crop policy, occlusion policy, and visibility eligibility to relations and exact obligations.",
      "acceptance_before_implementation": [
        "Invisible required regions produce UNSCORED rather than PASS or quality zero.",
        "Thumbnail and native gates remain separate.",
        "All required components must coexist in one evaluated result."
      ]
    },
    {
      "id": "VS-P0-003",
      "priority": "P0",
      "title": "Exact versus advisory activation guard",
      "status": "proposed",
      "target_layers": ["policy", "tool", "test"],
      "proposal": "Require literal request or authored exact evidence for new hard profiles and retain BM25F or embedding-only discoveries as optional candidates.",
      "acceptance_before_implementation": [
        "Narrow positive exact terms activate only their intended profile.",
        "Bare labels and nearest substitutes remain negative controls.",
        "Corpus frequency never installs a global default."
      ]
    },
    {
      "id": "VS-P0-004",
      "priority": "P0",
      "title": "Corpus fixture ledger and human relation graph",
      "status": "proposed",
      "target_layers": ["tool", "test"],
      "proposal": "Preserve corpus post ID, prompt hash, image hash, pair-alignment status, review scale, human-verified relation graph, and confusion role for every motivating or held-out fixture.",
      "acceptance_before_implementation": [
        "Duplicate prompt text with divergent pixels is not silently accepted as an aligned pair.",
        "Motivating and held-out fixtures are explicitly separated.",
        "Image lineage remains reproducible from the frozen manifest."
      ]
    },
    {
      "id": "VS-P0-005",
      "priority": "P0",
      "title": "Evidence-layer result schema",
      "status": "proposed",
      "target_layers": ["reference", "policy", "test"],
      "proposal": "Report package, prompt, runtime request, render, and user results independently; do not promote from an aggregate score.",
      "acceptance_before_implementation": [
        "Prompt or package PASS cannot be reported as pixel PASS.",
        "Blocked or missing output remains UNSCORED.",
        "User judgment remains a separate final layer."
      ]
    },
    {
      "id": "VS-P0-006",
      "priority": "P0",
      "title": "Generated-index lineage",
      "status": "proposed",
      "target_layers": ["tool", "test"],
      "proposal": "Regenerate semantic and visual-profile indexes only from authored registries and candidate sources, and verify source hashes in check mode.",
      "acceptance_before_implementation": [
        "Generated indexes are never edited as semantic authority.",
        "Check mode fails on source or shard mismatch.",
        "Unrelated working-tree changes are not staged or rewritten."
      ]
    }
  ],
