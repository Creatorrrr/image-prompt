CONTEXT_EN=[
'Copying a personality, running it, transferring it and preserving the original self are separate fictional or philosophical claims; visible cables do not establish survival.',
'Shared wires, synchronized poses and matching displays do not establish one consciousness or actual collective cognitive processing.',
'The philosophical body without organs, assemblage and rhizome are not literal prescriptions for organ removal or vine decoration; term-specific primary review remains pending.',
'Cloning, chimerism, parthenogenesis and extra-uterine gestation retain different biological or fictional meanings; bodily appearance does not establish reproductive rights or mechanisms.',
'Letter-like marks, circuits, prayer-like postures and light do not establish actual magic, divine response or demonstrated psionic engineering.',
'Sound without a visible source, odor, touch and synesthetic experience cannot themselves be verified in one still image.',
'Rust, ruins, layered markings and portraits do not establish age, a precursor civilization, time travel or chronological sequence.',
'Dream-work, condensation, displacement, the uncanny and the numinous are historical theories, interpretations or experiences; appearance does not diagnose a mind.',
'Eroticism, fetish meanings, jouissance and death-drive interpretations require their own declared critical or desire context; material gloss and exposure alone add none.',
'Adult consensual BDSM, sadism or masochism and fictional distributed consent retain separate agreement, role and subject conditions; a pose or restraint is not consent evidence.',
'Incest taboo and necrophilia remain research concepts about kinship, norms, death and desire; resemblance, pallor, sleep or artificial bodies do not establish those meanings.',
'Reproductive coercion, sexual violence and the monstrous-feminine concern autonomy, power or cultural construction; gender, pregnancy or anatomy is not a generic horror trait.',
'Dismemberment, flaying, evisceration, vivisection, cannibalism and autocannibalism retain distinct action, ownership, life-state and medium conditions; a model is not an actual injury substitute.',
'Visible allocation, maintenance, display and work differ from political claims about biopower, necropolitics, ownership, coercion or species discrimination.',
'Nested pictures, portals and reading gestures do not alone establish metalepsis, simulation or an information hazard; narrative levels and causal claims need context.',
'Care and cohabitation can be visually suggested without proving kinship, personhood, symbiotic benefit, freedom of form or voluntary participation.']

def main():
 before=read(O/'before.json');old=c.load(A);assert c.digest(old)==before['corpus_sha256'],'Concurrent source drift requires a new baseline'
 cards=read(Q/'semantic-cards.json')['cards'];contexts=read(Q/'context-records.json')['records'];keywords=read(Q/'keyword-register.json')['keywords']
 sources={x['source_id']:x for x in read(Q/'sources.json')['sources']};assert set(EFFECTS)==set(ALIASES)=={x['card_id'] for x in cards}
 records={};bindings={};registry=[];decisions=[];oldtexts={x.get('content',{}).get('en',''):cid for cid,x in old['candidates'].items()}
 for card in cards:
  key=card['card_id'];en=card['proposal_en'];ko=card['proposal_ko'];assert en not in oldtexts,'Exact duplicate requires full-source reuse decision'
  cid='cand_'+uuid.uuid5(uuid.NAMESPACE_URL,'image-prompt/surreal-posthuman-science-fantasy/20261022/'+key).hex;assert cid not in old['candidates']
  meta={**copy.deepcopy(card),'schema':'photo-surreal-posthuman-visual-semantics/v1','candidate_id':cid,'registration_status':'authored_source_module','source_refs':[sources[i] for i in card['source_ids']],'native_qualification':'not_qualified','graph_scope':'Research review only; not typed facts, native guards, owner authority or qualifications.','provenance_digest_scope':'research specification bytes, not web page bytes'}
  app='One complete optional fictional visual realization, never a genre-triggered obligation. Preserve the complete English and Korean positive meaning, every material, count, part, owner, same/different relation, current pose, contact, endpoint and continuity or separation. Use only when the independent requester meaning and every affected dimension/property permit the complete case. All required endpoints and qualifiers must remain visible together; cropped, hidden or partial evidence fails the full case. Research graphs, aliases and citations supply no native facts, guard evidence, existing-owner permissions or whole-source qualification. Visible arrangements alone do not establish identity survival, consciousness, genetics, life or death, kinship, desire, consent, coercion, rights, political institutions, historical age, sequence, sound or supernatural efficacy. An artificial component, anatomical model, fictional shell and actual human injury retain different meanings.'
  rec={'id':cid,'record_kind':'visual_option','content':{'en':en,'ko':ko,'definition':'Optional complete fictional visual realization: '+en,'aliases':[card['title_ko']]+ALIASES[key],'application_contract':app,'research_semantics':meta},'conditions':{'requires_adult_context':True} if 'adult' in en.lower() else {},'effects':{'dimensions':sorted(EFFECTS[key].split()),'properties':[]},'provenance':[{'source':sources[i]['url'],'sha256':sha(Q/'semantic-cards.json')} for i in card['source_ids']]}
  records[cid]=rec;registry.append(meta)
  for slot in card['proposed_slots']:
   assert slot in old['slot_catalog'];bid='bind_'+uuid.uuid5(uuid.NAMESPACE_URL,cid+'/'+slot).hex
   bindings[bid]={'id':bid,'candidate_id':cid,'slot_id':slot,'role':'optional','semantic_role':old['slot_catalog'][slot]['semantic_role'],'conditions':{'subject_applicability':{}},'weight':2}
  decisions.append({'card_id':key,'candidate_id':cid,'decision':'new_bounded_optional_variant','reason':'The whole scene adds a specific material/owner/endpoint/state relation; exact sentence duplicate absent. Nearby originals preserved rather than shortened. Full-corpus semantic novelty is not claimed.','native_approval':False})
 for card,en in zip(contexts,CONTEXT_EN,strict=True):
  key=card['context_id'];cid='cand_'+uuid.uuid5(uuid.NAMESPACE_URL,'image-prompt/surreal-posthuman-science-fantasy/20261022/'+key).hex
  meta={**copy.deepcopy(card),'card_id':key,'candidate_id':cid,'registration_status':'authored_diagnostic_module','native_qualification':'not_qualified'}
  records[cid]={'id':cid,'record_kind':'diagnostic','content':{'en':en,'ko':card['meaning_limit_ko'],'definition':'Context-only distinction; no positive still-image recipe.','aliases':[card['title_ko']],'application_contract':'Context-only research distinction, excluded from positive visual material retrieval. Preserve declared meaning without converting it to a fixed appearance rule, an owner permission or native qualification. No actual event is replaced by a model or unrelated ordinary prop.','research_semantics':meta},'conditions':{},'effects':{'dimensions':[],'properties':[]},'provenance':[{'source':sources[i]['url'],'sha256':sha(Q/'context-records.json')} for i in card['source_ids']]}
  registry.append(meta);decisions.append({'card_id':key,'candidate_id':cid,'decision':'context_diagnostic','native_approval':False})
 assert len(records)==88 and len(bindings)==144
 nm='photo_candidate_surreal_posthuman_science_fantasy_20261022.json';bm='photo_candidate_surreal_posthuman_science_fantasy_bindings_20261022.json'
 assert not (A/nm).exists() and not (A/bm).exists()
 manifest=read(A/c.MANIFEST_NAME);manifest['modules'] += [{'file':nm,'kind':'candidates'},{'file':bm,'kind':'slot_bindings'}]
 with source_update(S):
  assert c.digest(c.load(A))==before['corpus_sha256']
  write(A/nm,{'schema':c.MODULE_SCHEMAS['candidates'],'candidates':records});write(A/bm,{'schema':c.MODULE_SCHEMAS['slot_bindings'],'slot_bindings':bindings});write(A/c.MANIFEST_NAME,manifest)
  now=c.load(A);assert all(now['candidates'][k]==v for k,v in old['candidates'].items());assert all(now['slot_bindings'][k]==v for k,v in old['slot_bindings'].items());assert all(now[k]==old[k] for k in ['slot_catalog','policies'])
 context_routes={
  '중심축':['X01','X02','X05','X08','X14','X16'],'꿈과 연상':['X08'],
  '형태와 오브제':['X08','X15'],'초현실 공포':['X08','X13'],
  '인간 중심주의':['X03','X14','X16'],'몸과 인지':['X01','X02','X03'],
  '정신과 인격':['X01','X02','X07'],'종과 생식':['X04','X16'],
  '기술과 마법':['X05'],'신과 우주':['X05','X07'],'공간과 감각':['X06','X07'],
  '신체 공포와 폭력':['X13'],'욕망과 매혹':['X09','X10','X11'],
  '성 생식 동의':['X04','X10','X11','X12'],'서사 기법':['X07','X15'],
  '권력과 일상':['X14','X16']}
 context_ids={x['card_id']:x['candidate_id'] for x in registry if x['card_id'].startswith('X')}
 routes=[]
 for k in keywords:
  routes.append({**copy.deepcopy(k),'optional_visual_candidate_ids':[x['candidate_id'] for x in registry if x['card_id'][0] in k['candidate_family_routes']],'route_limit':'Advisory illustrative neighborhoods only; no full-term fulfillment, auto activation, role approval or permission.','context_candidate_ids':[context_ids[x] for x in context_routes[k['group']]]})
 result={'schema':'photo-surreal-posthuman-semantic-registry/v1','cards':registry,'keyword_routes':routes,'decisions':decisions,'native_approval':False,'counts':{'visual_options':72,'diagnostics':16,'bindings':len(bindings),'keyword_routes':182},'research_spec_sha256':sha(Q/'semantic-cards.json')}
 write(A/'photo_surreal_posthuman_science_fantasy_semantics_20261022.json',result)
 write(O/'new-native-records.json',records);write(O/'changed-native-records.json',{});write(O/'data-integration.json',result)
 write(O/'source-preservation.json',{'status':'pass','all_prior_candidate_records_byte_semantics_unchanged':len(old['candidates']),'all_prior_bindings_unchanged':len(old['slot_bindings']),'catalog_and_policies_unchanged':True,'new_candidates':len(records),'new_positive':72,'new_diagnostic':16,'new_bindings':len(bindings),'current_writes':0})
 print(json.dumps(result['counts']),flush=True)
