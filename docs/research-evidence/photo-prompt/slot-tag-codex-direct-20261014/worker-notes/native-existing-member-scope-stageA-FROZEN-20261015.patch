+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+PRE = ROOT / 'skills/photo-prompt-image-generator/precore'
+sys.path.insert(0, str(PRE))
+import photo_semantic_witnesses as n
+import photo_authoring_wire as wire
+
+TEXT = 'The coat coat_A and the glove glove_A are present. This complete local collection contains coat_A and glove_A.'
+LOCK = {'locked_dimensions':['subject'], 'open_dimensions':[]}
+
+
+def row(aid, kind, **axes):
+    return {'assertion_id':aid, 'dimension':'subject', 'polarity':'required',
+        'source_span_ids':['members'], 'axes':{'native_schema':n.SCHEMA, 'kind':kind, **axes},
+        'evidence':{'collection':TEXT}, 'affected_dimensions':['subject']}
+
+
+def inventory(envelope, owners):
+    return {'schema':n.MEMBER_SCOPE_SCHEMA, 'complete':True, 'state':'known_present',
+        'input_binding':n.input_binding(envelope),
+        'reviewed_input_ids':[item['id'] for item in envelope['input_inventory']['items']],
+        'members':[{'owner_id':owner, 'source_span_ids':['members'], 'source_input_ids':['request']}
+                   for owner in owners]}
+
+
+def fixture(owners=('coat_A','glove_A')):
+    text = TEXT if owners == ('coat_A','glove_A') else (
+        'These independently named existing physical owners are present: '+', '.join(owners)
+        +'. This complete local collection contains exactly these named owners.')
+    sha = hashlib.sha256(text.encode()).hexdigest()
+    env = wire.normalize_request_envelope({'contract_version':'photo-request-envelope/v1',
+        'provenance':'requesting_user', 'request_id':'existing_collection', 'request_text':text,
+        'request_sha256':sha, 'active_spans':[{'span_id':'members', 'start':0, 'end':len(text), 'text':text}],
+        'input_inventory':{'schema':n.INPUT_SCHEMA, 'complete':True, 'items':[
+            {'id':'request','kind':'request_text','sha256':sha},
+            {'id':'reference','kind':'reference_image','sha256':hashlib.sha256(b'independent fixture bytes').hexdigest()}]}})
+    rows=[]
+    # Explicit declarations; owner_kind grants neither presence nor anatomy.
+    for i, owner in enumerate(owners):
+        rows += [row('owner_'+str(i),'owner',owner=owner,owner_kind='physical_entity'),
+                 row('presence_'+str(i),'fact',owner=owner,property='entity.presence',
+                     value_type='entity.presence/v1',value='present')]
+    rows.append(row('collection','existing_member_scope',scope_id='local_outfit',
+                    inventory=n.canonical(inventory(env, owners))))
+    for item in rows:item['evidence']={'collection':text}
+    return rows, env
+
+
+def decoded(rows):
+    return json.loads(next(r for r in rows if r['axes']['kind']=='existing_member_scope')['axes']['inventory'])
+
+
+def replace_inventory(rows, value):
+    next(r for r in rows if r['axes']['kind']=='existing_member_scope')['axes']['inventory']=n.canonical(value)
+
+
+def read(rows, env, lock=LOCK):
+    return n.read(rows,env['active_spans'],env['request_text'],intent_lock=lock,request_binding=env)
+
