+def _context_covers(context,entries,core,*,allow_partial=False):
+    if context is not None and context.get('discovery_partial') and not allow_partial:return False
+    if context is None or context['core_sha256']!=c.digest(core):return False
+    for entry in entries:
+        proof=proof_of(entry);cid=_proof_cid(proof);node=context['nodes'].get(cid)
+        if (node is None or node['realization_id']!=entry.get('_realization_id','base')
+                or c.digest(proof)!=context['entries'][cid]['proof_sha256'] or entry.get('_native_owner_selections')!=context['owner_selections']):return False
+        # A child may carry a strict descendant subset of the root choices.
+        original=context['entries'][cid]['dependency_selections']
+        if any(original.get(k)!=v for k,v in entry.get('_native_dependency_selections',{}).items()):return False
+    return True
+
